# Copy to .env.local and fill in. Never commit .env.local — this repo is public.

# ── Supabase ─────────────────────────────────────────────────────────────────
# New-style keys. `sb_publishable_…` replaces the old anon key and is safe in the
# browser; `sb_secret_…` replaces service_role and must never reach the client bundle.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...

# Postgres, used ONLY by scripts/apply-schema.ts and scripts/seed.ts. Everything the
# app does at runtime goes through @supabase/supabase-js. Use the Supavisor pooler
# host — the direct-connection host is IPv6-only and unreachable from most CI.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# ── Anthropic ────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-5
# Optional. Unset uses the model's default reasoning budget, which is what the
# scores were calibrated against. `medium` is ~17% cheaper and measurably weaker on
# the headline finding — see DECISIONS.md and scripts/calibrate.ts before changing it.
# ANTHROPIC_EFFORT=medium

# ── Cron ─────────────────────────────────────────────────────────────────────
# Guards /api/cron/heartbeat. The daily heartbeat is not optional: a free Supabase
# project pauses after about seven days without database activity, and resuming is a
# manual dashboard click — which would break the "this URL still works next week"
# requirement the brief is explicit about.
CRON_SECRET=<any long random string>

# ── Delivery worker (optional; the TONE tab) ─────────────────────────────────
# Without these the app runs exactly the briefed transcript report and no tab bar
# appears. See delivery/README.md.
DELIVERY_WORKER_URL=https://leisuretimemovie--beavermind-delivery-api.modal.run
DELIVERY_WORKER_TOKEN=<matches the WORKER_TOKEN in the Modal secret>
